#include <iostream>
using namespace std;

int linear(int arr[],int item,int n){
    for(int i=0;i<n;i++){
        if(arr[i]==item)
            return i;
    }
    return -1;
}

void display(int arr[],int item,int n){
    for(int i=0;i<n;i++){
        cout<<"element of arr["<<i<<"]="<<arr[i]<<endl;
    }
    cout<<"item found at index "<<linear(arr, item, n)<<endl;
}

int main(){
    int arr[]={23,5,1,2,66,12,6,7,8835,7,2,16};
    int n=sizeof(arr)/sizeof(int);
    int item=12;
    display(arr,item,n);
}
