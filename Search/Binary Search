#include <iostream>
using namespace std;

int binary(int arr[],int item,int low,int high){
    if(high>=low){
        int mid=low+(high-low)/2;

        if(item==arr[mid])
        return mid;

        if(item<arr[mid])
        return binary(arr,item,low,mid-1);

        else
            return binary(arr,item,mid+1,high);
    }
    return -1;
}

int main(){
    int arr[]={3,4,5,6,7,8,9,17,22};
    int n=sizeof(arr)/sizeof(int);
    int low=0;
    int high=n-1;
    int item=9;
    for(int i=0;i<n;i++){
        cout<<"element arr["<<i<<"]="<<arr[i]<<endl;
    }
    int result = binary(arr, item, low, high);
    if (result == -1)
    cout<<"\nThere is no such an Element"<<endl;
    else
    cout<<"\nElement is found at index " << result<<endl;
    return 0;
}
