#include <iostream>

void merge(int arr[], int sol, int orta, int sag) {
    int i, j, k;
    int n1 = orta - sol + 1;
    int n2 = sag - orta;

    int* L = new int[n1];
    int* R = new int[n2];

    for (i = 0; i < n1; i++)
        L[i] = arr[sol + i];
    for (j = 0; j < n2; j++)
        R[j] = arr[orta + 1 + j];

    i = 0; 
    j = 0; 
    k = sol; 

    while (i < n1 && j < n2) {
        if (L[i] <= R[j]) {
            arr[k] = L[i];
            i++;
        } else {
            arr[k] = R[j];
            j++;
        }
        k++;
    }

    while (i < n1) {
        arr[k] = L[i];
        i++;
        k++;
    }

    while (j < n2) {
        arr[k] = R[j];
        j++;
        k++;
    }

    delete[] L;
    delete[] R;
}

void mergeSort(int arr[], int sol, int sag) {
    if (sol < sag) {
        int orta = sol + (sag - sol) / 2;

        mergeSort(arr, sol, orta);
        mergeSort(arr, orta + 1, sag);

        merge(arr, sol, orta, sag);
    }
}
