#include <iostream>
using namespace std;

void swap(int*a,int*b){
    int temp=*a;
    *a=*b;
    *b=temp;
}
void selection(int arr[],int n){
    for(int i=0;i<n;i++){
        int min_index=i;
        for(int j=i+1;j<n;j++){
            if(arr[j]<arr[min_index]){
                min_index=j;
            }
        }
        swap(&arr[i],&arr[min_index]);
    }
}
int main(){
    int arr[]={3,4,521,2,51,56,31,58,52,61,23,23};
    int n=sizeof(arr)/sizeof(int);
    selection(arr, n);
    for(int i=0;i<n;i++)
        cout<<arr[i]<<" ";
}
