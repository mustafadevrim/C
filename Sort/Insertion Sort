#include <iostream>
using namespace std;

void insertionSort(int arr[], int n) {
    for (int i = 1; i < n; i++) {
        int current = arr[i];
        int j = i - 1;

        while (j >= 0 && arr[j] > current) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = current;
    }
}

int main(){
    int arr[]={2,3,56,12,52,56,75,2,3,45,5,123,72};
    int n=sizeof(arr)/sizeof(int);
    insertionSort(arr,n);
    for(int i=0;i<n;i++)
        cout<<arr[i]<<" ";
}
